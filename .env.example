# Roqqu Studio - environment template.
#
#   cp .env.example .env   then fill in only what you want.
#
# EVERYTHING here is optional. `docker compose up` works with this file empty
# (Rooky routes by keyword, orders run on the mock adapter, tests pass keyless).
# Keys only UNLOCK live features. Roqqu has no sandbox: live calls stay refused
# until ALLOW_PRODUCTION_EXECUTION=true.
# Never commit your real .env.

# --- AI: pick one provider so Rooky composes from free text (else keyword routing)
# AI_PROVIDER selects which runs: anthropic | openai | google | nvidia
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=                 # free credits: https://build.nvidia.com -> Get API Key (nvapi-...)

# --- Roqqu API Service (https://roqqu-api-services.gitbook.io/ras)
# Keys: RAS console -> Settings -> API Keys and Webhooks. Start with a TEST key:
# it calls the real API without moving real money. Webhook URL to set there:
# https://<web-domain>/api/ras/webhook (bodies are encrypted with your key).
RAS_TEST_KEY=                  # sent as x-staging-api-key
RAS_LIVE_KEY=                  # sent as x-api-key; real money, needs the flag below
RAS_MODE=                      # practice | test | live (blank: test when RAS_TEST_KEY is set)
ROQQU_PAY_TOKEN=usdt_trc20     # studio deposit page default: usdt_trc20 | usdt_bep20 | btc
ROQQU_NGN_PER_USD=1360         # fallback only, used when RAS GET /rates is unreachable
ALLOW_PRODUCTION_EXECUTION=false

# --- Email receipts (ZeptoMail transactional API, not SMTP)
# ZEPTOMAIL_API_KEY is the FULL Authorization value incl. prefix, e.g.
#   Zoho-enczapikey <token>
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_SENDER=
ZEPTOMAIL_REPLY_TO=

# --- WhatsApp nudges (Evolution API). Leave blank to no-op.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- Demo notification target: where a flow's notify block sends when the node
# names no recipient (so the demo notification lands somewhere you can see it).
STUDIO_NOTIFY_NUMBER=          # e.g. 08110774138
STUDIO_NOTIFY_EMAIL=           # e.g. you@example.com
