  {
   "id": "create-payment-link",
   "section": "Payment links",
   "title": "Create Payment Link",
   "summary": "Creates a new payment link that generates unique wallet addresses for customers to make cryptocurrency payments. Supported networks: Bitcoin (BTC), Tron (TRC20 USDT), and BNB Smart Chain (BEP20 USDT). You can either pre-generate wallet addresses at creation by passing the `wallets` parameter, or omit it to have wallets generated on demand when the customer starts a payment session (via the payment link session endpoint). See **Get Supported Networks** above for the list of valid network/token combinations.",
   "method": "POST",
   "path": "/payment-links",
   "auth": true,
   "moves_money": false,
   "paid_lookup": false,
   "side_effects": true,
   "note": "payment_reference: 1-20 letters and numbers. Links expire after 2 hours by default.",
   "params": [
    {
     "name": "amount",
     "in": "body",
     "required": true,
     "type": "number",
     "default": "1000",
     "description": "Payment amount (must be greater than 0)"
    },
    {
     "name": "customer_details",
     "in": "body",
     "required": true,
     "type": "string",
     "default": "{\"email\":\"customer@example.com\",\"first_name\":\"John\",\"last_name\":\"Doe\",\"phone\":\"+1234567890\"}",
     "description": "JSON string containing customer information. Required fields: email, first_name, last_name. Optional field: phone"
    },
    {
     "name": "payment_reference",
     "in": "body",
     "required": true,
     "type": "string",
     "default": "ORDER123ABC",
     "description": "Alphanumeric reference for this payment (1-20 characters, letters and numbers only). Used to identify the payment in your system"
    },
    {
     "name": "success_url",
     "in": "body",
     "required": true,
     "type": "string",
     "default": "https://yourwebsite.com/payment/success",
     "description": "HTTPS URL to redirect customer after successful payment. Must use HTTPS protocol"
    },
    {
     "name": "cancel_url",
     "in": "body",
     "required": true,
     "type": "string",
     "default": "https://yourwebsite.com/payment/cancel",
     "description": "HTTPS URL to redirect customer if payment is cancelled. Must use HTTPS protocol"
    },
    {
     "name": "expires_at",
     "in": "body",
     "required": false,
     "type": "string",
     "default": "",
     "description": "ISO 8601 date-time when the payment link expires. Must be a future date. If not provided, defaults to 2 hours from creation time"
    },
    {
     "name": "metadata",
     "in": "body",
     "required": false,
     "type": "string",
     "default": "",
     "description": "Optional JSON string containing additional metadata you want to store with the payment link. This will be included in webhook notifications"
    },
    {
     "name": "amount_currency",
     "in": "body",
     "required": false,
     "type": "string",
     "default": "ngn",
     "description": "Currency code for the amount (default: 'ngn'). Must be a supported currency"
    },
    {
     "name": "wallets",
     "in": "body",
     "required": false,
     "type": "object",
     "default": "[{\"network\":\"bitcoin\",\"token\":\"BTC\"},{\"network\":\"trc20\",\"token\":\"USDT\"},{\"network\":\"bep20\",\"token\":\"USDT\"}]",
     "description": "Optional array of `{ network, token }` objects. If provided and non-empty, wallet addresses are generated at creation. If omitted or empty, wallets are generated on demand when the customer starts a session. Valid combinations: bitcoin/BTC, trc20/USDT, bep20/USDT. Only one wallet per network allowed"
    }
   ],
   "examples": {
    "200": {
     "status": "success",
     "message": "payment link generated successfully",
     "data": {
      "refid": "abc123def456ghi789",
      "payment_reference": "ORDER123ABC",
      "payment_link": "https://payment.roqqu.com/abc123def456ghi789",
      "wallets": [
       {
        "address": "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa",
        "network": "bitcoin",
        "token": "BTC"
       },
       {
        "address": "TXYZabcdefghijklmnopqrstuvwxyz123456",
        "network": "trc20",
        "token": "USDT"
       },
       {
        "address": "0x1234567890abcdef1234567890abcdef12345678",
        "network": "bep20",
        "token": "USDT"
       }
      ],
      "wallet_pre_generated": 1,
      "amount_required": 1000,
      "amount_currency": "ngn",
      "expires_at": "2024-12-31T23:59:59Z"
     }
    }
   },
   "doc_url": "https://roqqu-api-services.gitbook.io/ras/payment-links/create-payment-link"
  },
